# TEMPORA Environment Variables Example

# ==========================================
# Database (Neon PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://neondb_owner:npg_PnofHuBjd3U2@ep-late-rice-b3tznt7s-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=tempora-super-secret-jwt-key-2025-change-in-production-min32chars
JWT_REFRESH_SECRET=tempora-super-secret-refresh-key-2025-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Google OAuth & Maps
# ==========================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==========================================
# AI Engine (OpenAI / Gemini / Anthropic)
# ==========================================
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-flash

# ==========================================
# Payments (Razorpay / Stripe)
# ==========================================
PAYMENT_PROVIDER=stripe
PAYMENT_KEY_ID=pk_test_sample_tempora
PAYMENT_KEY_SECRET=sk_test_sample_tempora

# ==========================================
# URLs & CORS
# ==========================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
